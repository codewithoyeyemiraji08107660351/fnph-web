# Leave empty when the API is served from the same origin under /api (recommended, see deploy/nginx.conf).
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api.
VITE_API_PROXY_TARGET=http://localhost:8080

# Shown on safety notices only if /api/v1/public/settings cannot be reached.
# The live value is managed by the Central Administrator.
VITE_FALLBACK_EMERGENCY_NUMBER=08032722243

# Used until public settings load. Must match the backend inactivity timeout.
VITE_FALLBACK_INACTIVITY_MINUTES=30
